# Copy this file to .env and choose your own values. .env is listed in .gitignore and never committed.
# docker compose reads .env automatically.

# Password of the database user "blog" (used by MySQL and the backend). Required for docker-compose.app.yml.
DB_PASSWORD=change-me
# Password of the MySQL root user. Required for docker-compose.app.yml.
DB_ROOT_PASSWORD=change-me-too
# Password of the Keycloak admin console user "kcadmin" (default: kcadmin)
KEYCLOAK_ADMIN_PASSWORD=kcadmin

# Backend image, e.g. :0.1 for a fixed version or :0.1-native for the native image
BACKEND_IMAGE=ghcr.io/farisridzal-hftm/blog-backend:latest
